model User {
  id Int @id @default(autoincrement())

  name    String?
  email   String  @unique
  sNumber String

  reservations       Reservation[]
  googleSSOUsers     GoogleSSOUser[]
  microsoftSSOUsers  MicrosoftSSOUser[]
  rosterEntries       RosterEntry[]
  eventRegistrations  EventRegistration[]
  bracketParticipants BracketParticipant[]
  timeTrialParticipants  TimeTrialParticipant[]
  pointTrialParticipants PointTrialParticipant[]
  userRoles           UserRole[]

  dynamicFormSubmissions        DynamicFormSubmission[]
  dynamicFormSubmissionComments DynamicFormSubmissionComment[]

  notesAbout   UserNote[] @relation("UserNoteSubject")
  notesAuthored UserNote[] @relation("UserNoteAuthor")

  planningMemberships PlanningTeamMember[]
}

model UserNote {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation("UserNoteSubject", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  authorId  Int
  author    User     @relation("UserNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type      UserNoteType @default(NOTE)
  content   String

  /// When the note stops counting; null keeps it active until someone ends it.
  expiresAt DateTime?

  /// When this warning was e-mailed to the person it is about; null when it was not.
  emailedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, expiresAt])
}

/// NOTE and WARNING are for staff only; an active BLOCK also keeps the person off the site.
enum UserNoteType {
  NOTE
  WARNING
  BLOCK
}

model GoogleSSOUser {
  id     Int    @id @default(autoincrement())
  ssoId  String @unique
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model MicrosoftSSOUser {
  id     Int    @id @default(autoincrement())
  ssoId  String @unique
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)

  permissions RolePermission[]
  userRoles   UserRole[]
  formAccess  DynamicFormAccess[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
}
