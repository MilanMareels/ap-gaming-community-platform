model User {
  id Int @id @default(autoincrement())

  name    String?
  email   String  @unique
  sNumber String

  reservations       Reservation[]
  adminUsers         AdminUser[]
  googleSSOUsers     GoogleSSOUser[]
  microsoftSSOUsers  MicrosoftSSOUser[]
  rosterEntries       RosterEntry[]
  eventRegistrations  EventRegistration[]
  bracketParticipants BracketParticipant[]
  timeTrialParticipants  TimeTrialParticipant[]
  pointTrialParticipants PointTrialParticipant[]
  userRoles           UserRole[]
  speedrunRunsSubmitted  SpeedrunRun[]       @relation("SpeedrunRunSubmitter")
  speedrunRunsVerified   SpeedrunRun[]       @relation("SpeedrunRunVerifier")
  speedrunRunPlayers     SpeedrunRunPlayer[]
}

model AdminUser {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model GoogleSSOUser {
  id     Int    @id @default(autoincrement())
  ssoId  String @unique
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model MicrosoftSSOUser {
  id     Int    @id @default(autoincrement())
  ssoId  String @unique
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)

  permissions RolePermission[]
  userRoles   UserRole[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
}
