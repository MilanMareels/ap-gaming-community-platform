model Setting {
  id Int @id @default(autoincrement())

  key   String @unique
  value String
}

model Form {
  id    Int    @id @default(autoincrement())
  title String
  url   String
}

model NavLink {
  id         Int     @id @default(autoincrement())
  label      String
  href       String?
  icon       String?

  parentId Int?
  parent   NavLink?  @relation("NavLinkChildren", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children NavLink[] @relation("NavLinkChildren")

  position     Int
  visibility   String  @default("public")
  isCta        Boolean @default(false)
  openInNewTab Boolean @default(false)
  isProtected  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RosterGame {
  id            Int           @id @default(autoincrement())
  name          String
  rosterEntries RosterEntry[]
}

model RosterEntry {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  gameId Int
  game   RosterGame @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  handle String
  rank   String
  role   String?

  imageUrl String?
}
